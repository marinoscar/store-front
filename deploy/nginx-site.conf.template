# Shared nginx config for static-serving containers.
# Bind-mounted into every static-* container in compose.yml.

server {
    listen 80 default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Astro emits clean URLs without trailing slashes (trailingSlash: 'never').
    location / {
        try_files $uri $uri.html $uri/index.html =404;
    }

    # Long-cache fingerprinted assets emitted by Astro/Vite under /_astro/
    location /_astro/ {
        access_log off;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Cache other static assets for a week
    location ~* \.(?:jpg|jpeg|png|webp|avif|svg|ico|woff2?)$ {
        access_log off;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    # Don't cache the HTML — content changes on each deploy
    location ~* \.html$ {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;
    gzip_min_length 1024;

    server_tokens off;
}
