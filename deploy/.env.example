# Copy to .env on the VPS and fill in every value.
# .env is gitignored — it must never be committed.

# --- Service ---
PORT=3000
LOG_LEVEL=info
NODE_ENV=production
SITES_CONFIG=/app/sites.config.json

# Comma-separated origins allowed by CORS. Include scheme; no trailing slash.
ALLOWED_ORIGINS=https://myhomeimprovementcompany.com,https://mypressurewashingcompany.com

# --- Rate limit (per IP) ---
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Quotes <quotes@example.com>"

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=600

# --- AWS S3 ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUT_EXPIRES=900
S3_GET_EXPIRES=3600

# --- Uploads ---
MAX_UPLOAD_MB=15
MAX_FILES_PER_QUOTE=8
ALLOWED_UPLOAD_MIME=image/jpeg,image/png,image/webp

# --- Geocoding ---
# Provider: mapbox | google | smarty
GEOCODE_PROVIDER=mapbox
GEOCODE_API_KEY=
