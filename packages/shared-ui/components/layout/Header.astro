---
import type { SiteMeta } from '@store-front/shared-ui/lib/types';

interface Props {
  meta: SiteMeta;
  navItems?: Array<{ href: string; label: string }>;
}

const { meta, navItems = [
  { href: '#services', label: 'Services' },
  { href: '#process', label: 'How it works' },
  { href: '#reviews', label: 'Reviews' },
  { href: '#faq', label: 'FAQ' },
  { href: '#quote', label: 'Get a quote' },
] } = Astro.props;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label={meta.brandName}>
      <strong>{meta.brandName}</strong>
    </a>

    <nav aria-label="Primary" class="site-header__nav">
      {navItems.map((item) => (
        <a href={item.href} class="site-header__link">{item.label}</a>
      ))}
    </nav>

    <a class="btn btn--accent site-header__cta" href={`tel:${meta.phoneE164}`} aria-label={`Call ${meta.phone}`}>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      <span>{meta.phone}</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: saturate(180%) blur(8px);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.75rem;
  }
  .site-header__brand {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    color: var(--color-primary);
  }
  .site-header__nav {
    display: none;
    gap: 1.5rem;
  }
  .site-header__link {
    font-weight: 600;
    color: var(--color-fg);
    transition: color var(--motion-fast);
  }
  .site-header__link:hover {
    color: var(--color-primary);
  }
  .site-header__cta {
    padding: 0.625rem 1rem;
    font-size: var(--fs-sm);
  }
  .site-header__cta span {
    display: none;
  }
  @media (min-width: 720px) {
    .site-header__cta span { display: inline; }
  }
  @media (min-width: 880px) {
    .site-header__nav { display: flex; }
  }
</style>
