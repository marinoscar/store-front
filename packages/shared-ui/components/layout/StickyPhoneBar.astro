---
import type { SiteMeta } from '@store-front/shared-ui/lib/types';
interface Props { meta: SiteMeta; }
const { meta } = Astro.props;
---

<div class="phonebar" aria-label="Call now">
  <a class="phonebar__cta" href={`tel:${meta.phoneE164}`}>
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    <span>Call {meta.phone}</span>
  </a>
  <a class="phonebar__cta phonebar__cta--accent" href="#quote">Get a quote</a>
</div>

<style>
  .phonebar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    padding: 0;
    background: var(--color-primary);
    z-index: 40;
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.15);
  }
  .phonebar__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 1rem;
    background: var(--color-primary);
    color: var(--color-primary-fg);
    font-weight: 700;
    font-size: var(--fs-sm);
  }
  .phonebar__cta--accent {
    background: var(--color-accent);
    color: var(--color-accent-fg);
  }
  @media (min-width: 880px) {
    .phonebar { display: none; }
  }
</style>
