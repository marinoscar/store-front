---
import type { BeforeAfterPair } from '@store-front/shared-ui/lib/types';

interface Props {
  title?: string;
  pairs: BeforeAfterPair[];
}

const { title = 'Before &amp; after', pairs } = Astro.props;
---

<section id="before-after" class="section">
  <div class="container">
    <span class="eyebrow">Recent work</span>
    <h2 set:html={title}></h2>

    <div class="ba__grid grid">
      {pairs.map((p) => (
        <figure class="ba__item">
          <div class="ba__images">
            <div class="ba__col">
              <span class="ba__tag">Before</span>
              <img src={p.before} alt="Before" loading="lazy" width="600" height="400" />
            </div>
            <div class="ba__col">
              <span class="ba__tag ba__tag--accent">After</span>
              <img src={p.after} alt="After" loading="lazy" width="600" height="400" />
            </div>
          </div>
          <figcaption>{p.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .ba__grid { margin-top: 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); }
  .ba__images { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  .ba__col { position: relative; }
  .ba__col img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); }
  .ba__tag { position: absolute; top: 0.5rem; left: 0.5rem; background: rgba(17, 24, 39, 0.85); color: white; font-size: var(--fs-xs); font-weight: 700; padding: 0.25rem 0.625rem; border-radius: 999px; }
  .ba__tag--accent { background: var(--color-accent); color: var(--color-accent-fg); }
  figcaption { margin-top: 0.625rem; color: var(--color-muted); font-size: var(--fs-sm); }
</style>
