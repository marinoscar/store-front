---
import type { Service } from '@store-front/shared-ui/lib/types';

interface Props {
  title?: string;
  intro?: string;
  services: Service[];
}

const { title = 'What we do', intro, services } = Astro.props;
---

<section id="services" class="section section--surface">
  <div class="container">
    <span class="eyebrow">Services</span>
    <h2>{title}</h2>
    {intro && <p class="services__intro">{intro}</p>}

    <div class="services__grid grid grid--3">
      {services.map((s) => (
        <article class="service-card card" data-service-id={s.id}>
          <img src={s.image} alt="" width="640" height="400" loading="lazy" class="service-card__img" />
          <h3>{s.name}</h3>
          <p>{s.shortDescription}</p>
          {s.highlights && (
            <ul class="service-card__highlights">
              {s.highlights.map((h) => <li>• {h}</li>)}
            </ul>
          )}
          <a class="btn btn--accent service-card__cta" href={`#quote?service=${encodeURIComponent(s.id)}`}>
            Get a quote
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services__intro { color: var(--color-muted); margin-top: 0.5rem; }
  .services__grid { margin-top: 2rem; }
  .service-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .service-card__img {
    border-radius: var(--radius);
    aspect-ratio: 5 / 3;
    object-fit: cover;
    margin-bottom: 0.75rem;
  }
  .service-card h3 { font-size: var(--fs-md); }
  .service-card p { color: var(--color-muted); font-size: var(--fs-sm); }
  .service-card__highlights { list-style: none; padding: 0; color: var(--color-muted); font-size: var(--fs-sm); margin-top: 0.25rem; }
  .service-card__cta { margin-top: auto; align-self: flex-start; padding: 0.625rem 1.25rem; font-size: var(--fs-sm); }
</style>
