---
import type { SiteMeta } from '@store-front/shared-ui/lib/types';

interface Props {
  meta: SiteMeta;
}

const { meta } = Astro.props;
const items = [
  meta.yearsInBusiness ? `${meta.yearsInBusiness}+ years` : null,
  'Licensed & insured',
  'Free quotes',
  'Locally owned',
  ...(meta.certifications ?? []),
].filter((s): s is string => Boolean(s));
---

<section class="trust section">
  <div class="container trust__row">
    {items.map((label) => (
      <div class="trust__badge">
        <span aria-hidden="true">★</span>
        <span>{label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .trust { padding-block: 1.5rem; border-block: 1px solid var(--color-border); background: var(--color-surface-2); }
  .trust__row { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem 2rem; }
  .trust__badge { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; color: var(--color-fg); font-size: var(--fs-sm); }
  .trust__badge span:first-child { color: var(--color-accent); }
</style>
