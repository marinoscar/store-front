---
import type { ProcessStep } from '@store-front/shared-ui/lib/types';

interface Props {
  title?: string;
  steps: ProcessStep[];
}

const { title = 'How it works', steps } = Astro.props;
---

<section id="process" class="section">
  <div class="container">
    <span class="eyebrow">Process</span>
    <h2>{title}</h2>

    <ol class="process__list">
      {steps.map((step) => (
        <li class="process__item">
          <div class="process__num">{step.step}</div>
          <div>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process__list {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  .process__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.25rem;
  }
  .process__num {
    width: 40px; height: 40px;
    display: grid; place-items: center;
    background: var(--color-primary);
    color: var(--color-primary-fg);
    border-radius: 50%;
    font-weight: 800;
  }
  .process__item h3 { font-size: var(--fs-md); }
  .process__item p { color: var(--color-muted); font-size: var(--fs-sm); margin-top: 0.25rem; }
  @media (min-width: 720px) {
    .process__list { grid-template-columns: repeat(2, 1fr); }
  }
</style>
